{
  "name": "learn-agent",
  "version": "1.0.5",
  "private": true,
  "description": "Local desktop app for agent-assisted learning notes, summaries, and RAG chat.",
  "main": "electron-dist/main.cjs",
  "author": "LearnAgent",
  "type": "module",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:electron && tsc && vite build",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "preview": "vite preview",
    "start": "npm run build:electron && electron .",
    "check": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest",
    "test:unit": "npm run build:electron && vitest run",
    "test:electron-smoke": "npm run build && node scripts/electron-smoke.cjs",
    "verify": "npm run check && npm run test:unit && npm run build && npm audit",
    "benchmark:storage": "npm run build:electron && node scripts/storage-benchmark.cjs",
    "check:bundle-budget": "node scripts/check-bundle-budget.cjs"
  },
  "build": {
    "appId": "com.learnagent.desktop",
    "productName": "LearnAgent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LearnAgent-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LearnAgent"
    }
  },
  "dependencies": {
    "@tiptap/extension-color": "^3.28.0",
    "@tiptap/extension-highlight": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/extension-table": "^3.28.0",
    "@tiptap/extension-text-style": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.6",
    "wait-on": "^8.0.1"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "tar": "7.5.22"
  }
}
