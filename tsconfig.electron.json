{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "electron"],
    "rootDir": "electron-src",
    "outDir": "electron-dist",
    "strict": false,
    "checkJs": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "noEmitOnError": true
  },
  "include": ["electron-src/**/*.cts", "electron-src/**/*.ts"]
}
